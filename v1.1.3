<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Syllable Clap & Count Challenge + Hybrid Gradebook</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg: #F0F7FF;
      --card-bg: #FFFFFF;
      --primary: #4F46E5;
      --primary-hover: #4338CA;
      --accent: #F59E0B;
      --accent-soft: #FEF3C7;
      --success: #10B981;
      --success-light: #D1FAE5;
      --wrong: #EF4444;
      --wrong-light: #FEE2E2;
      --teacher: #0D9488;
      --teacher-light: #CCFBF1;
      --text-main: #1E293B;
      --text-muted: #64748B;
      --radius-lg: 24px;
      --radius-md: 16px;
      --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Fredoka', 'Quicksand', sans-serif;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      background: var(--bg);
      background-image: radial-gradient(#CBD5E1 1.5px, transparent 1.5px);
      background-size: 24px 24px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 16px;
      color: var(--text-main);
    }

    .container {
      width: 100%;
      max-width: 600px;
    }

    /* Top Bar */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--card-bg);
      padding: 12px 20px;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow);
      margin-bottom: 16px;
      font-weight: 600;
      flex-wrap: wrap;
      gap: 8px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: #EEF2FF;
      color: var(--primary);
      border-radius: 999px;
      font-size: 0.95rem;
    }

    .btn-text {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.85rem;
      text-decoration: underline;
      font-weight: 600;
      margin-left: 4px;
    }

    .btn-teacher {
      background: var(--teacher-light);
      color: #0F766E;
      border: 1.5px solid #99F6E4;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .btn-teacher:hover {
      background: #99F6E4;
      transform: translateY(-1px);
    }

    /* Cloud Sync Status Indicator */
    .sync-indicator {
      font-size: 0.75rem;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--text-muted);
      margin-top: 4px;
    }
    .sync-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #94A3B8;
    }
    .sync-dot.active { background: #10B981; }

    /* Main Card */
    .card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      padding: 32px 24px;
      box-shadow: var(--shadow);
      text-align: center;
      position: relative;
      border: 3px solid #E2E8F0;
    }

    .progress-bar-container {
      width: 100%;
      height: 10px;
      background: #E2E8F0;
      border-radius: 999px;
      margin-bottom: 24px;
      overflow: hidden;
    }

    .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #6366F1, #10B981);
      width: 0%;
      transition: width 0.3s ease;
    }

    .word-text {
      font-size: 3.2rem;
      font-weight: 700;
      color: #1E1B4B;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }

    /* Audio Buttons */
    .audio-actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .btn-audio {
      background: #EEF2FF;
      color: var(--primary);
      border: 2px solid #C7D2FE;
      padding: 10px 22px;
      border-radius: 999px;
      cursor: pointer;
      font-size: 1.1rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.15s ease;
    }

    .btn-audio:hover {
      background: #E0E7FF;
      transform: translateY(-2px);
    }

    /* Syllable Options (1-4) */
    .choices-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      margin-bottom: 20px;
    }

    .choice-btn {
      background: #F8FAFC;
      border: 3px solid #E2E8F0;
      border-radius: var(--radius-md);
      padding: 16px 12px;
      cursor: pointer;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      transition: all 0.15s ease;
    }

    .choice-btn:hover:not(:disabled) {
      background: #F1F5F9;
      border-color: #CBD5E1;
      transform: translateY(-2px);
    }

    .choice-btn.selected-correct {
      background: var(--success-light);
      border-color: var(--success);
      color: #065F46;
      animation: bounce 0.4s ease;
    }

    .choice-btn.selected-wrong {
      background: var(--wrong-light);
      border-color: var(--wrong);
      color: #991B1B;
      animation: shake 0.4s ease;
    }

    .choice-btn.is-correct-target {
      background: var(--success-light);
      border-color: var(--success);
      color: #065F46;
    }

    .choice-btn:disabled {
      cursor: default;
    }

    /* Syllable Chips Breakdown */
    .syllable-chips {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin: 16px 0;
      flex-wrap: wrap;
    }

    .chip {
      background: #EEF2FF;
      color: var(--primary);
      border: 2px solid #C7D2FE;
      padding: 8px 18px;
      border-radius: 999px;
      font-size: 1.4rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .chip:hover {
      background: #E0E7FF;
      transform: scale(1.05);
    }

    .explanation-box {
      background: #F8FAFC;
      border-radius: var(--radius-md);
      padding: 16px;
      margin: 18px 0;
      border: 2px solid #E2E8F0;
      display: none;
      animation: fadeIn 0.3s ease;
    }

    .explanation-box.show {
      display: block;
    }

    /* Next Button (Manual Advance) */
    .btn-next {
      background: linear-gradient(135deg, #4F46E5, #6366F1);
      color: white;
      border: none;
      width: 100%;
      padding: 16px 24px;
      border-radius: var(--radius-md);
      font-size: 1.25rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
      display: none;
      align-items: center;
      justify-content: center;
      gap: 8px;
      animation: popIn 0.3s ease;
    }

    .btn-next:hover {
      background: linear-gradient(135deg, #4338CA, #4F46E5);
      transform: translateY(-2px);
    }

    .btn-next.show {
      display: inline-flex;
    }

    /* Modals */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 100;
    }

    .modal-box {
      background: white;
      border-radius: var(--radius-lg);
      padding: 28px 24px;
      width: 100%;
      max-width: 440px;
      text-align: center;
      box-shadow: var(--shadow);
      position: relative;
    }

    .id-display {
      letter-spacing: 12px;
      font-size: 2.2rem;
      font-weight: 700;
      background: #F1F5F9;
      padding: 12px;
      border-radius: var(--radius-md);
      border: 2px solid #CBD5E1;
      margin: 16px 0;
      min-height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1E293B;
    }

    .keypad {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 16px;
    }

    .key-btn {
      background: #F8FAFC;
      border: 2px solid #E2E8F0;
      border-radius: var(--radius-md);
      padding: 14px 0;
      font-size: 1.4rem;
      font-weight: 700;
      cursor: pointer;
      color: #334155;
    }

    .key-btn:hover {
      background: #EEF2FF;
      border-color: #C7D2FE;
    }

    .btn-primary-start {
      background: var(--primary);
      color: white;
      border: none;
      width: 100%;
      padding: 14px;
      border-radius: var(--radius-md);
      font-size: 1.2rem;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-primary-start:disabled {
      background: #94A3B8;
      cursor: not-allowed;
    }

    /* Teacher Portal Modal */
    .teacher-modal-box {
      max-width: 740px;
      text-align: left;
      max-height: 92vh;
      display: flex;
      flex-direction: column;
    }

    .teacher-tabs {
      display: flex;
      gap: 8px;
      margin: 14px 0 10px 0;
      border-bottom: 2px solid #E2E8F0;
      padding-bottom: 8px;
    }

    .tab-btn {
      background: none;
      border: none;
      padding: 8px 14px;
      font-weight: 700;
      color: var(--text-muted);
      cursor: pointer;
      border-radius: 8px;
      font-size: 0.95rem;
    }

    .tab-btn.active {
      background: #E0F2FE;
      color: #0369A1;
    }

    .teacher-stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 14px;
    }

    .stat-card {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 12px;
      padding: 10px;
      text-align: center;
    }

    .stat-value {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--primary);
    }

    .stat-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
    }

    .table-container {
      overflow-y: auto;
      max-height: 280px;
      border: 1px solid #E2E8F0;
      border-radius: 12px;
      margin-bottom: 14px;
    }

    table.roster-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9rem;
    }

    table.roster-table th {
      background: #F1F5F9;
      padding: 10px 12px;
      font-weight: 700;
      color: #475569;
      position: sticky;
      top: 0;
      z-index: 2;
    }

    table.roster-table td {
      padding: 8px 12px;
      border-bottom: 1px solid #F1F5F9;
    }

    table.roster-table tr:hover td {
      background: #F8FAFC;
    }

    .teacher-actions {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: auto;
      padding-top: 10px;
    }

    .btn-secondary {
      background: #E2E8F0;
      color: #334155;
      border: none;
      padding: 8px 14px;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-export {
      background: var(--teacher);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .close-btn {
      position: absolute;
      top: 16px;
      right: 18px;
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: var(--text-muted);
    }

    /* Results Screen */
    .review-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      text-align: left;
      margin: 18px 0;
      max-height: 200px;
      overflow-y: auto;
      padding-right: 6px;
    }

    .review-item {
      background: #F8FAFC;
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid #E2E8F0;
      font-size: 0.95rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
    }

    @keyframes bounce { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 75% { transform: translateX(6px); } }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes popIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
  </style>
</head>
<body>

  <div class="container">
    <!-- Top Bar -->
    <div class="top-bar">
      <div>
        <span class="badge" id="studentBadge">👤 Student: #00000</span>
        <button class="btn-text" onclick="showLoginModal()">Switch ID</button>
      </div>
      <div style="display: flex; gap: 8px; align-items: center;">
        <span class="badge" style="background:#FEF3C7; color:#B45309;" id="highScoreBadge">⭐ Best: 0/12</span>
        <button class="btn-teacher" onclick="openTeacherAuthModal()">
          <span>👩‍🏫</span> Teacher
        </button>
      </div>
    </div>

    <!-- Main Game Card -->
    <div class="card" id="gameCard">
      <div class="progress-bar-container">
        <div class="progress-bar-fill" id="progressBar"></div>
      </div>

      <div style="font-size: 0.95rem; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;" id="questionCounter">
        Question 1 of 12
      </div>

      <div class="word-text" id="targetWord">classroom</div>

      <!-- Natural Audio Control (Single Clear Word Listen) -->
      <div class="audio-actions">
        <button class="btn-audio" onclick="speakCurrentWord()">
          <span>🔊</span> Listen Word
        </button>
      </div>

      <!-- Syllable Choices (1-4) -->
      <div class="choices-grid" id="choicesGrid">
        <button class="choice-btn" onclick="submitAnswer(1)">
          <span>1 Syllable</span>
          <span style="letter-spacing:2px;">👏</span>
        </button>
        <button class="choice-btn" onclick="submitAnswer(2)">
          <span>2 Syllables</span>
          <span style="letter-spacing:2px;">👏👏</span>
        </button>
        <button class="choice-btn" onclick="submitAnswer(3)">
          <span>3 Syllables</span>
          <span style="letter-spacing:2px;">👏👏👏</span>
        </button>
        <button class="choice-btn" onclick="submitAnswer(4)">
          <span>4 Syllables</span>
          <span style="letter-spacing:2px;">👏👏👏👏</span>
        </button>
      </div>

      <!-- Syllable Breakdown Box -->
      <div class="explanation-box" id="explanationBox">
        <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">
          Tap each chunk to hear its sound:
        </div>
        <div class="syllable-chips" id="syllableChips"></div>
        <div id="feedbackText" style="font-size: 1.15rem; font-weight: 700; margin-top: 8px;"></div>
      </div>

      <!-- Explicit Manual Advance -->
      <button class="btn-next" id="nextBtn" onclick="handleNextClick()">
        Next Word ➔
      </button>
    </div>

    <!-- Results Card -->
    <div class="card" id="resultsCard" style="display: none;">
      <h2 style="font-size: 2rem; color: var(--primary); margin-bottom: 8px;">Round Complete! 🎉</h2>
      <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 8px;">Your score was recorded to your ID!</p>
      
      <!-- Confirmation of Sync -->
      <div class="sync-indicator" id="resultsSyncStatus">
        <span class="sync-dot active"></span> Local Saved &nbsp;•&nbsp; <span id="cloudStatusText">☁️ Syncing to Teacher Google Sheet...</span>
      </div>

      <div style="font-size: 2.4rem; font-weight: 700; margin: 12px 0;" id="finalScoreDisplay">
        ⭐ 12 / 12
      </div>
      <div id="newBestBadge" style="display:none; color:#10B981; font-weight:700; font-size:1.1rem; margin-bottom:12px;">
        ✨ New Personal Best Record! ✨
      </div>

      <div style="font-weight: 700; text-align: left; margin-top: 14px;">Syllable Word Review (Tap to listen):</div>
      <div class="review-grid" id="reviewList"></div>

      <div style="display: flex; gap: 12px; margin-top: 18px;">
        <!-- Prompts for ID entry every time! -->
        <button class="btn-primary-start" onclick="restartGame()">Play Again 🔄</button>
      </div>
    </div>
  </div>

  <!-- Student ID Login Modal -->
  <div class="modal-overlay" id="loginModal" style="display: none;">
    <div class="modal-box">
      <h3 style="font-size: 1.5rem; margin-bottom: 6px;">Student Login 👋</h3>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Enter your 5-digit Student ID to record your scores.</p>
      
      <div class="id-display" id="idDisplay">_____</div>

      <div class="keypad">
        <button class="key-btn" onclick="typeDigit('1')">1</button>
        <button class="key-btn" onclick="typeDigit('2')">2</button>
        <button class="key-btn" onclick="typeDigit('3')">3</button>
        <button class="key-btn" onclick="typeDigit('4')">4</button>
        <button class="key-btn" onclick="typeDigit('5')">5</button>
        <button class="key-btn" onclick="typeDigit('6')">6</button>
        <button class="key-btn" onclick="typeDigit('7')">7</button>
        <button class="key-btn" onclick="typeDigit('8')">8</button>
        <button class="key-btn" onclick="typeDigit('9')">9</button>
        <button class="key-btn" onclick="clearDigit()" style="color:var(--wrong);">⌫</button>
        <button class="key-btn" onclick="typeDigit('0')">0</button>
        <button class="key-btn" onclick="randomDemoId()" style="font-size:0.9rem; color:var(--primary);">Demo</button>
      </div>

      <button class="btn-primary-start" id="loginBtn" disabled onclick="saveStudentId()">Start Game</button>
    </div>
  </div>

  <!-- Teacher PIN Auth Modal -->
  <div class="modal-overlay" id="teacherAuthModal" style="display: none;">
    <div class="modal-box">
      <button class="close-btn" onclick="closeModals()">✕</button>
      <h3 style="font-size: 1.4rem; margin-bottom: 6px;">Teacher Verification 🔒</h3>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px;">
        Enter Teacher PIN to open settings and gradebook.<br><small>(Default PIN: <b>1234</b>)</small>
      </p>
      
      <input type="password" id="teacherPinInput" maxlength="6" placeholder="PIN" 
             style="font-size: 1.8rem; text-align: center; letter-spacing: 8px; width: 160px; padding: 8px; border-radius: 12px; border: 2px solid #CBD5E1; margin-bottom: 16px;">
      
      <div id="pinError" style="color: var(--wrong); font-size: 0.9rem; margin-bottom: 12px; display: none;">
        Incorrect PIN. Please try again.
      </div>

      <button class="btn-primary-start" onclick="verifyTeacherPin()">Unlock Dashboard</button>
    </div>
  </div>

  <!-- Teacher Gradebook & Cloud Settings Modal -->
  <div class="modal-overlay" id="teacherDashboardModal" style="display: none;">
    <div class="modal-box teacher-modal-box">
      <button class="close-btn" onclick="closeModals()">✕</button>
      
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <h3 style="font-size: 1.4rem; color: #0F766E;">👩‍🏫 Teacher Portal</h3>
      </div>

      <!-- Navigation Tabs -->
      <div class="teacher-tabs">
        <button class="tab-btn active" id="tabRosterBtn" onclick="switchTeacherTab('roster')">📊 Class Roster</button>
        <button class="tab-btn" id="tabSettingsBtn" onclick="switchTeacherTab('settings')">⚙️ Google Sheet Sync</button>
      </div>

      <!-- Tab 1: Roster View -->
      <div id="rosterTabView">
        <div class="teacher-stats-grid">
          <div class="stat-card">
            <div class="stat-value" id="statTotalStudents">0</div>
            <div class="stat-label">Students</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="statAvgScore">0.0</div>
            <div class="stat-label">Class Avg</div>
          </div>
          <div class="stat-card">
            <div class="stat-value" id="statPerfectScores">0</div>
            <div class="stat-label">12/12 Perfect</div>
          </div>
        </div>

        <div style="margin-bottom: 10px;">
          <input type="text" id="rosterSearch" placeholder="🔍 Search Student ID..." 
                 oninput="filterRoster()"
                 style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1.5px solid #CBD5E1; font-size: 0.9rem;">
        </div>

        <div class="table-container">
          <table class="roster-table">
            <thead>
              <tr>
                <th>Student ID</th>
                <th>Best</th>
                <th>Latest</th>
                <th>Plays</th>
                <th>Last Active</th>
              </tr>
            </thead>
            <tbody id="rosterTableBody"></tbody>
          </table>
        </div>

        <div class="teacher-actions">
          <button class="btn-secondary" onclick="clearAllScoresConfirm()" style="color: #991B1B; font-size: 0.8rem;">
            🗑️ Clear Local
          </button>
          <button class="btn-export" onclick="exportToCSV()">
            <span>📥</span> Download CSV
          </button>
        </div>
      </div>

      <!-- Tab 2: Google Sheets Setup -->
      <div id="settingsTabView" style="display: none; font-size: 0.95rem;">
        <p style="color: var(--text-muted); margin-bottom: 12px;">
          Sync student scores to your Google Sheet automatically whenever they finish a round.
        </p>

        <label style="font-weight: 700; display: block; margin-bottom: 6px;">Google Apps Script Web App URL:</label>
        <input type="text" id="sheetUrlInput" placeholder="https://script.google.com/macros/s/.../exec"
               style="width: 100%; padding: 10px; border-radius: 8px; border: 1.5px solid #CBD5E1; font-size: 0.85rem; margin-bottom: 12px;">

        <div style="display: flex; gap: 8px; margin-bottom: 16px;">
          <button class="btn-primary-start" style="padding: 10px;" onclick="saveSheetUrl()">Save URL</button>
          <button class="btn-secondary" onclick="sendTestScore()">Send Test Row 🧪</button>
        </div>

        <div style="background: #F8FAFC; padding: 12px; border-radius: 10px; border: 1px solid #E2E8F0; font-size: 0.85rem; color: #475569;">
          <b>Quick Checklist:</b>
          <ol style="margin-left: 20px; margin-top: 4px; line-height: 1.4;">
            <li>Deploy Apps Script as <b>Web app</b>.</li>
            <li>Set <i>"Who has access"</i> to <b>Anyone</b>.</li>
            <li>Paste your URL above and click Save.</li>
          </ol>
        </div>
      </div>

    </div>
  </div>

  <script>
    // -------------------------------------------------------------
    // 1. DATA WITH AUTHENTIC PHONETIC TRANSCRIPTIONS
    // -------------------------------------------------------------
    const WORD_BANK = [
      { word: "pen", syllables: 1, displaySyllables: ["pen"], phoneticSyllables: ["pen"] },
      { word: "tall", syllables: 1, displaySyllables: ["tall"], phoneticSyllables: ["tall"] },
      { word: "classroom", syllables: 2, displaySyllables: ["class", "room"], phoneticSyllables: ["class", "room"] },
      { word: "happy", syllables: 2, displaySyllables: ["hap", "py"], phoneticSyllables: ["hap", "pee"] },
      { word: "teacher", syllables: 2, displaySyllables: ["teach", "er"], phoneticSyllables: ["teach", "er"] },
      { word: "yellow", syllables: 2, displaySyllables: ["yel", "low"], phoneticSyllables: ["yel", "low"] },
      { word: "beautiful", syllables: 3, displaySyllables: ["beau", "ti", "ful"], phoneticSyllables: ["byoo", "tih", "ful"] },
      { word: "hamburger", syllables: 3, displaySyllables: ["ham", "bur", "ger"], phoneticSyllables: ["ham", "ber", "ger"] },
      { word: "seventeen", syllables: 3, displaySyllables: ["sev", "en", "teen"], phoneticSyllables: ["sev", "en", "teen"] },
      { word: "eraser", syllables: 3, displaySyllables: ["e", "ra", "ser"], phoneticSyllables: ["ih", "ray", "zer"] },
      { word: "supermarket", syllables: 4, displaySyllables: ["su", "per", "mar", "ket"], phoneticSyllables: ["soo", "per", "mar", "kit"] },
      { word: "alligator", syllables: 4, displaySyllables: ["al", "li", "ga", "tor"], phoneticSyllables: ["al", "li", "gay", "ter"] }
    ];

    // -------------------------------------------------------------
    // 2. STATE & HYBRID STORAGE
    // -------------------------------------------------------------
    const TEACHER_PIN = "1234";
    let studentId = "";
    let studentHighScore = 0;
    let questions = [];
    let currentIndex = 0;
    let currentScore = 0;
    let isAnswered = false;
    let typedId = "";
    let rosterData = {};

    function getSheetUrl() {
      return localStorage.getItem("syllables_sheet_url") || "";
    }

    function loadRosterData() {
      try {
        const stored = localStorage.getItem("syllables_roster_data");
        rosterData = stored ? JSON.parse(stored) : {};
      } catch (e) {
        rosterData = {};
      }
    }

    function saveRosterRecord(id, score) {
      loadRosterData();
      const existing = rosterData[id] || { bestScore: 0, latestScore: 0, attempts: 0, lastActive: "" };
      const newBest = Math.max(existing.bestScore, score);
      const now = new Date().toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

      rosterData[id] = {
        bestScore: newBest,
        latestScore: score,
        attempts: existing.attempts + 1,
        lastActive: now
      };

      localStorage.setItem("syllables_roster_data", JSON.stringify(rosterData));
      localStorage.setItem(`syllables_high_${id}`, newBest);
    }

    // Silent Cloud Sync to Google Sheet
    async function syncScoreToGoogleSheet(id, score, total = 12) {
      const url = getSheetUrl();
      const cloudStatusEl = document.getElementById("cloudStatusText");

      if (!url) {
        if (cloudStatusEl) cloudStatusEl.innerText = "☁️ Google Sheet URL not configured";
        return;
      }

      if (cloudStatusEl) cloudStatusEl.innerText = "☁️ Syncing to Teacher Google Sheet...";

      try {
        await fetch(url, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            studentId: id,
            score: score,
            total: total
          })
        });
        if (cloudStatusEl) cloudStatusEl.innerText = "☁️ Synced to Google Sheet! ✓";
      } catch (err) {
        if (cloudStatusEl) cloudStatusEl.innerText = "☁️ Offline (Saved locally)";
      }
    }

    // -------------------------------------------------------------
    // 3. AUDIO ENGINE & SYNTHESIS
    // -------------------------------------------------------------
    let audioCtx = null;
    function getAudioCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playChime(isCorrect) {
      try {
        const ctx = getAudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);

        if (isCorrect) {
          osc.type = "triangle";
          osc.frequency.setValueAtTime(523.25, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(659.25, ctx.currentTime + 0.1);
          gain.gain.setValueAtTime(0.3, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
          osc.start();
          osc.stop(ctx.currentTime + 0.35);
        } else {
          osc.type = "sawtooth";
          osc.frequency.setValueAtTime(220, ctx.currentTime);
          osc.frequency.linearRampToValueAtTime(170, ctx.currentTime + 0.25);
          gain.gain.setValueAtTime(0.2, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.25);
          osc.start();
          osc.stop(ctx.currentTime + 0.25);
        }
      } catch (e) {}
    }

    let availableVoices = [];
    function loadVoices() { availableVoices = window.speechSynthesis.getVoices(); }
    if (window.speechSynthesis) {
      loadVoices();
      window.speechSynthesis.onvoiceschanged = loadVoices;
    }

    function getBestNativeVoice() {
      if (!availableVoices.length) loadVoices();
      const preferred = availableVoices.find(v => 
        (v.name.includes("Google") || v.name.includes("Natural") || v.name.includes("Samantha") || v.name.includes("Ava")) &&
        (v.lang.startsWith("en-US") || v.lang.startsWith("en-GB"))
      );
      return preferred || availableVoices.find(v => v.lang.startsWith("en")) || null;
    }

    function speakCurrentWord() {
      const q = questions[currentIndex];
      if (!q || !window.speechSynthesis) return;
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(q.word);
      utter.rate = 0.88;
      utter.pitch = 1.05;
      const v = getBestNativeVoice();
      if (v) utter.voice = v;
      window.speechSynthesis.speak(utter);
    }

    function speakSingleSyllable(phoneticText) {
      if (!window.speechSynthesis) return;
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(phoneticText);
      utter.rate = 0.85;
      utter.pitch = 1.08;
      const v = getBestNativeVoice();
      if (v) utter.voice = v;
      window.speechSynthesis.speak(utter);
    }

    // -------------------------------------------------------------
    // 4. GAMEPLAY LOGIC
    // -------------------------------------------------------------
    function initGame() {
      questions = [...WORD_BANK].sort(() => Math.random() - 0.5);
      currentIndex = 0;
      currentScore = 0;
      loadCard();
    }

    function loadCard() {
      isAnswered = false;
      const q = questions[currentIndex];

      document.getElementById("questionCounter").innerText = `Word ${currentIndex + 1} of 12`;
      document.getElementById("progressBar").style.width = `${((currentIndex) / 12) * 100}%`;
      document.getElementById("targetWord").innerText = q.word;

      const buttons = document.querySelectorAll(".choice-btn");
      buttons.forEach(btn => {
        btn.className = "choice-btn";
        btn.disabled = false;
      });

      const chipsContainer = document.getElementById("syllableChips");
      chipsContainer.innerHTML = "";
      q.displaySyllables.forEach((syl, i) => {
        const chip = document.createElement("div");
        chip.className = "chip";
        chip.innerHTML = `${syl} <span style="font-size:0.8rem; opacity:0.6;">🔊</span>`;
        chip.onclick = () => speakSingleSyllable(q.phoneticSyllables[i]);
        chipsContainer.appendChild(chip);
      });

      document.getElementById("explanationBox").classList.remove("show");
      document.getElementById("feedbackText").innerHTML = "";
      const nextBtn = document.getElementById("nextBtn");
      nextBtn.classList.remove("show");
      nextBtn.innerText = (currentIndex === 11) ? "See Final Results 🏆" : "Next Word ➔";

      setTimeout(() => speakCurrentWord(), 250);
    }

    function submitAnswer(chosenNumber) {
      if (isAnswered) return;
      isAnswered = true;

      const q = questions[currentIndex];
      const buttons = document.querySelectorAll(".choice-btn");
      buttons.forEach(b => b.disabled = true);

      const isCorrect = (chosenNumber === q.syllables);
      const chosenButton = buttons[chosenNumber - 1];

      if (isCorrect) {
        currentScore++;
        chosenButton.classList.add("selected-correct");
        playChime(true);
        document.getElementById("feedbackText").innerHTML = 
          `<span style="color:var(--success);">✨ Correct! <b>"${q.word}"</b> has <b>${q.syllables}</b> syllable${q.syllables > 1 ? 's' : ''}!</span>`;
      } else {
        chosenButton.classList.add("selected-wrong");
        buttons[q.syllables - 1].classList.add("is-correct-target");
        playChime(false);
        document.getElementById("feedbackText").innerHTML = 
          `<span style="color:var(--wrong);">Good try! <b>"${q.word}"</b> has <b>${q.syllables}</b> syllable${q.syllables > 1 ? 's' : ''}.</span>`;
      }

      document.getElementById("explanationBox").classList.add("show");
      document.getElementById("nextBtn").classList.add("show");
    }

    function handleNextClick() {
      currentIndex++;
      if (currentIndex < 12) {
        loadCard();
      } else {
        showResults();
      }
    }

    function showResults() {
      document.getElementById("gameCard").style.display = "none";
      const resultsCard = document.getElementById("resultsCard");
      resultsCard.style.display = "block";

      document.getElementById("finalScoreDisplay").innerText = `⭐ ${currentScore} / 12`;
      
      const isNewBest = currentScore > studentHighScore;
      if (isNewBest) {
        studentHighScore = currentScore;
        document.getElementById("newBestBadge").style.display = "block";
      } else {
        document.getElementById("newBestBadge").style.display = "none";
      }

      // 1. SAVE LOCALLY
      if (studentId) {
        saveRosterRecord(studentId, currentScore);
      }
      updateTopBar();

      // 2. SYNC TO GOOGLE SHEET
      syncScoreToGoogleSheet(studentId, currentScore, 12);

      // Render review list
      const reviewList = document.getElementById("reviewList");
      reviewList.innerHTML = "";
      WORD_BANK.forEach(item => {
        const div = document.createElement("div");
        div.className = "review-item";
        div.innerHTML = `
          <span><b>${item.word}</b> (${item.displaySyllables.join(" • ")})</span>
          <span style="font-weight:700; color:var(--primary);">[${item.syllables}] 🔊</span>
        `;
        div.onclick = () => {
          const utter = new SpeechSynthesisUtterance(item.word);
          utter.rate = 0.88;
          const v = getBestNativeVoice();
          if (v) utter.voice = v;
          window.speechSynthesis.speak(utter);
        };
        reviewList.appendChild(div);
      });
    }

    // ALWAYS prompts for Student ID when restarting
    function restartGame() {
      document.getElementById("resultsCard").style.display = "none";
      showLoginModal();
    }

    // -------------------------------------------------------------
    // 5. STUDENT ID SYSTEM (ALWAYS REQUIRED)
    // -------------------------------------------------------------
    function showLoginModal() {
      typedId = "";
      renderTypedId();
      document.getElementById("loginModal").style.display = "flex";
    }

    function typeDigit(d) {
      if (typedId.length < 5) {
        typedId += d;
        renderTypedId();
      }
    }

    function clearDigit() {
      typedId = typedId.slice(0, -1);
      renderTypedId();
    }

    function randomDemoId() {
      typedId = Math.floor(10000 + Math.random() * 90000).toString();
      renderTypedId();
    }

    function renderTypedId() {
      document.getElementById("idDisplay").innerText = typedId.padEnd(5, "_");
      document.getElementById("loginBtn").disabled = typedId.length !== 5;
    }

    function saveStudentId() {
      if (typedId.length === 5) {
        studentId = typedId;
        loadRosterData();
        studentHighScore = (rosterData[studentId] && rosterData[studentId].bestScore) || 0;
        updateTopBar();
        document.getElementById("loginModal").style.display = "none";
        document.getElementById("gameCard").style.display = "block";
        initGame();
      }
    }

    function updateTopBar() {
      document.getElementById("studentBadge").innerText = `👤 Student: #${studentId || '-----'}`;
      document.getElementById("highScoreBadge").innerText = `⭐ Best: ${studentHighScore}/12`;
    }

    // -------------------------------------------------------------
    // 6. TEACHER PORTAL & GOOGLE SHEET SETTINGS
    // -------------------------------------------------------------
    function openTeacherAuthModal() {
      document.getElementById("teacherPinInput").value = "";
      document.getElementById("pinError").style.display = "none";
      document.getElementById("teacherAuthModal").style.display = "flex";
    }

    function verifyTeacherPin() {
      const pin = document.getElementById("teacherPinInput").value;
      if (pin === TEACHER_PIN) {
        document.getElementById("teacherAuthModal").style.display = "none";
        openTeacherDashboard();
      } else {
        document.getElementById("pinError").style.display = "block";
      }
    }

    function openTeacherDashboard() {
      loadRosterData();
      renderRosterTable();
      updateTeacherMetrics();
      document.getElementById("sheetUrlInput").value = getSheetUrl();
      switchTeacherTab('roster');
      document.getElementById("teacherDashboardModal").style.display = "flex";
    }

    function switchTeacherTab(tab) {
      if (tab === 'roster') {
        document.getElementById("rosterTabView").style.display = "block";
        document.getElementById("settingsTabView").style.display = "none";
        document.getElementById("tabRosterBtn").classList.add("active");
        document.getElementById("tabSettingsBtn").classList.remove("active");
      } else {
        document.getElementById("rosterTabView").style.display = "none";
        document.getElementById("settingsTabView").style.display = "block";
        document.getElementById("tabRosterBtn").classList.remove("active");
        document.getElementById("tabSettingsBtn").classList.add("active");
      }
    }

    function saveSheetUrl() {
      const url = document.getElementById("sheetUrlInput").value.trim();
      localStorage.setItem("syllables_sheet_url", url);
      alert("Google Sheets Webhook URL saved successfully!");
    }

    function sendTestScore() {
      const url = getSheetUrl();
      if (!url) {
        alert("Please paste your Google Apps Script URL first!");
        return;
      }
      syncScoreToGoogleSheet("99999", 12, 12);
      alert("Sent test record for ID #99999! Check your Google Sheet to confirm it appears.");
    }

    function updateTeacherMetrics() {
      const ids = Object.keys(rosterData);
      const totalStudents = ids.length;
      let totalScoreSum = 0;
      let perfectCount = 0;

      ids.forEach(id => {
        totalScoreSum += rosterData[id].bestScore;
        if (rosterData[id].bestScore === 12) perfectCount++;
      });

      const avg = totalStudents > 0 ? (totalScoreSum / totalStudents).toFixed(1) : "0.0";
      document.getElementById("statTotalStudents").innerText = totalStudents;
      document.getElementById("statAvgScore").innerText = avg;
      document.getElementById("statPerfectScores").innerText = perfectCount;
    }

    function renderRosterTable(filterText = "") {
      const tbody = document.getElementById("rosterTableBody");
      tbody.innerHTML = "";

      const ids = Object.keys(rosterData).sort((a, b) => rosterData[b].bestScore - rosterData[a].bestScore);
      const filtered = ids.filter(id => id.includes(filterText));

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:#94A3B8; padding:20px;">No student records found.</td></tr>`;
        return;
      }

      filtered.forEach(id => {
        const item = rosterData[id];
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <td><b style="color:var(--primary);">#${id}</b></td>
          <td><span style="background:#FEF3C7; color:#B45309; padding:2px 8px; border-radius:999px; font-weight:700;">⭐ ${item.bestScore} / 12</span></td>
          <td>${item.latestScore} / 12</td>
          <td>${item.attempts}</td>
          <td style="color:var(--text-muted); font-size:0.8rem;">${item.lastActive || "—"}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    function filterRoster() {
      const query = document.getElementById("rosterSearch").value.trim();
      renderRosterTable(query);
    }

    function exportToCSV() {
      loadRosterData();
      const ids = Object.keys(rosterData);
      if (ids.length === 0) {
        alert("No student records to export yet!");
        return;
      }

      let csv = "Student ID,Best Score,Max Possible,Latest Score,Total Attempts,Last Active Date\n";
      ids.forEach(id => {
        const item = rosterData[id];
        csv += `"${id}",${item.bestScore},12,${item.latestScore},${item.attempts},"${item.lastActive}"\n`;
      });

      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `syllable_class_scores_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function clearAllScoresConfirm() {
      if (confirm("Are you sure you want to reset all local class scores?")) {
        rosterData = {};
        localStorage.removeItem("syllables_roster_data");
        renderRosterTable();
        updateTeacherMetrics();
      }
    }

    function closeModals() {
      document.getElementById("teacherAuthModal").style.display = "none";
      document.getElementById("teacherDashboardModal").style.display = "none";
    }

    // -------------------------------------------------------------
    // INITIALIZATION: ALWAYS SHOWS LOGIN FIRST
    // -------------------------------------------------------------
    window.addEventListener("DOMContentLoaded", () => {
      loadRosterData();
      showLoginModal();
    });
  </script>
</body>
</html>
